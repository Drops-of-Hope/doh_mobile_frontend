# Copy to .env for local development. Never commit .env.
# EXPO_PUBLIC_* variables are inlined into the JS bundle by Expo — never put
# secrets in them.

# Backend API base URL.
#  - Android emulator: defaults to http://10.0.2.2:5000/api when unset
#  - iOS simulator:    defaults to http://localhost:5000/api when unset
#  - Physical device:  set to http://<your-machine-LAN-IP>:5000/api
#  - Production build: set to the deployed backend URL (https)
EXPO_PUBLIC_API_URL=

# Sentry DSN for crash reporting (safe to expose; it only permits event intake)
EXPO_PUBLIC_SENTRY_DSN=

# WSO2 Asgardeo login (see app/services/auth.ts)
#  - ISSUER:    defaults to https://api.asgardeo.io/t/dropsofhope when unset
#  - CLIENT_ID: required — no default; login will fail without it
#  - APP_SCHEME: deep link scheme for native/dev builds, defaults to com.dropsofhope
EXPO_PUBLIC_ASGARDEO_ISSUER=
EXPO_PUBLIC_ASGARDEO_CLIENT_ID=
EXPO_PUBLIC_APP_SCHEME=
